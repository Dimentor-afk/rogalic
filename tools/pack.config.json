{
  "srcRoot": "assets-src",
  "outRoot": "public/assets",
  "maxWidth": 1024,
  "padding": 2,
  "packs": {
    "roguelike": "Roguelike Dungeon - Asset Bundle",
    "caves": "PixelFantasy_Caves_1.0",
    "dummy": "Training Dummy 2D Pixel Art"
  },
  "atlases": {
    "player": {
      "scale": 0.5,
      "trim": true,
      "sources": [
        {
          "kind": "frames",
          "pack": "roguelike",
          "dir": "Sprites/Player",
          "match": "^(Sword|Axe|Scepter)/Defence(\\d)/Player_(Idle|Walk|Attack)_[A-Za-z]+_Defence\\d_(\\d+)\\.png$",
          "name": "player/$1/d$2/$3/$4"
        },
        {
          "kind": "frames",
          "pack": "roguelike",
          "dir": "Sprites/Player",
          "match": "^(Sword|Axe|Scepter)/Player_Death_[A-Za-z]+_(\\d+)\\.png$",
          "name": "player/$1/death/$2"
        },
        {
          "kind": "frames",
          "pack": "roguelike",
          "dir": "Sprites/Player",
          "match": "^Special/Player_(Idle|Walk|Attack|Death)_Special_(\\d+)\\.png$",
          "name": "player/special/$1/$2"
        },
        {
          "kind": "frames",
          "pack": "roguelike",
          "dir": "Sprites/Player",
          "match": "^Scepter/Projectile/Player_(Blast|Projectile)_(\\d+)\\.png$",
          "name": "fx/scepter_$1/$2"
        }
      ]
    },
    "cave": {
      "scale": 1,
      "trim": false,
      "extrude": 1,
      "sources": [
        {
          "kind": "cells",
          "pack": "caves",
