{
  "name": "dodep",
  "private": true,
  "version": "0.1.0",
  "description": "ДОДЕП — soulslike-рогалик + казино-слот (Phaser 3 + TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "tsx tools/pack-sprites.ts",
    "sim": "tsx tools/simulate-slot.ts"
  },
  "dependencies": {
    "@fontsource/tiny5": "5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
